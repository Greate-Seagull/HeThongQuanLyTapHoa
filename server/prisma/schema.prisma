generator client {
  provider      = "prisma-client"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  address     String?
  phoneNumber String?
  products    Product[]
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  products    Product[]
}

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String?
  unit               ProductUnit         @default(PIECE)
  price              Int
  amount             Int                 @default(0)
  barcode            Int                 @unique
  status             ProductStatus       @default(GOOD)
  categoryId         Int?
  supplierId         Int?
  expiryDate         DateTime?
  goodReceiptDetails GoodReceiptDetail[]
  invoiceDetails     InvoiceDetail[]
  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  promotionDetails   PromotionDetail[]
  slotDetails        SlotDetail[]
  stocktakingDetails StocktakingDetail[]
}

model Promotion {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  startedAt        DateTime
  endedAt          DateTime
  value            Float
  promotionType    PromotionType
  invoiceDetails   InvoiceDetail[]
  promotionDetails PromotionDetail[]
}

model PromotionDetail {
  productId   Int
  promotionId Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([productId, promotionId])
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  point    Int       @default(0)
  avatar   String?
  accounts Account[]
  invoices Invoice[]
}

model Account {
  id           Int      @id @default(autoincrement())
  userId       Int
  phoneNumber  String   @unique
  passwordHash String
  loggedAt     DateTime @default(now())
  salt         String
  user         User     @relation(fields: [userId], references: [id])
}

model Employee {
  id               Int               @id @default(autoincrement())
  name             String
  position         EmployeePosition
  avatar           String?
  employeeAccounts EmployeeAccount[]
  goodReceipts     GoodReceipt[]
  invoices         Invoice[]
  stocktakings     Stocktaking[]
}

model EmployeeAccount {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  username     String   @unique
  passwordHash String
  salt         String
  loggedAt     DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model Invoice {
  id             Int             @id @default(autoincrement())
  employeeId     Int
  userId         Int?
  usedPoint      Int             @default(0)
  total          Int
  createdAt      DateTime        @default(now())
  employee       Employee        @relation(fields: [employeeId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  invoiceDetails InvoiceDetail[]
}

model InvoiceDetail {
  invoiceId      Int
  productId      Int
  quantity       Int
  promotionId    Int?
  discountAmount Int        @default(0)
  finalPrice     Int        @default(0)
  price          Int        @default(0)
  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id])
  promotion      Promotion? @relation(fields: [promotionId], references: [id])

  @@id([invoiceId, productId])
}

model GoodReceipt {
  id                 Int                 @id @default(autoincrement())
  employeeId         Int
  createdAt          DateTime
  employee           Employee            @relation(fields: [employeeId], references: [id])
  goodReceiptDetails GoodReceiptDetail[]
}

model GoodReceiptDetail {
  goodReceiptId Int
  productId     Int
  quantity      Int
  price         Int
  goodReceipt   GoodReceipt @relation(fields: [goodReceiptId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@id([goodReceiptId, productId])
}

model Shelf {
  id    Int    @id @default(autoincrement())
  name  String
  racks Rack[]
}

model Rack {
  id      Int    @id @default(autoincrement())
  name    String
  shelfId Int
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  slots   Slot[]
}

model Slot {
  id                 Int                 @id @default(autoincrement())
  name               String
  rackId             Int
  rack               Rack                @relation(fields: [rackId], references: [id], onDelete: Cascade)
  slotDetails        SlotDetail[]
  stocktakingDetails StocktakingDetail[]
}

model SlotDetail {
  slotId    Int
  productId Int
  quantity  Int     @default(0) // Số lượng sản phẩm trong ô
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  slot      Slot    @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([slotId, productId])
}

model Stocktaking {
  id                 Int                 @id @default(autoincrement())
  employeeId         Int
  createdAt          DateTime            @default(now())
  employee           Employee            @relation(fields: [employeeId], references: [id])
  stocktakingDetails StocktakingDetail[]
}

model StocktakingDetail {
  id            Int           @id @default(autoincrement())
  stocktakingId Int
  productId     Int
  slotId        Int
  status        ProductStatus
  quantity      Int
  product       Product       @relation(fields: [productId], references: [id])
  slot          Slot          @relation(fields: [slotId], references: [id])
  stocktaking   Stocktaking   @relation(fields: [stocktakingId], references: [id], onDelete: Cascade)
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

enum ProductUnit {
  PIECE
  BOX
  BOTTLE
  CAN
  PACKAGE
  BAG
  KG
  GRAM
  LITER
  ML
}

enum ProductStatus {
  GOOD
  EXPIRED
}

enum EmployeePosition {
  SALES
  INVENTORY
  RECEIVING
  MANAGER
}
